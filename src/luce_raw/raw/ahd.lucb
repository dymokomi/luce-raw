#==============================================================================================
#
#   raw/ahd - Adaptive homogeneity-directed demosaicing
#
#   DESCRIPTION:
#       Hirakawa and Parks' AHD as dcraw and LibRaw implement it, in the same integer
#       arithmetic so results agree with them: green is interpolated once
#       horizontally and once vertically, red and blue follow each green, both
#       candidates go to CIELAB, and each pixel takes the direction whose 3×3
#       neighbourhood is more homogeneous in lightness and chroma. Work is per tile;
#       a tile reads up to five pixels beyond its rectangle, so the five-pixel border
#       of the image is filled by averaging neighbours instead (border.lucb).
#
#==============================================================================================

## CIELAB in dcraw's integer scale (64 per unit) from 16-bit camera RGB: XYZ in
## 16.16 fixed point, then tables of the cube-root response already scaled
## for L*, a* and b*, so no pixel needs a float conversion.
struct LabTable:
    var lightness: i32[]
    var red_green: i32[]
    var blue_yellow: i32[]
    var to_xyz: i64[9]

    static func create(to_xyz: f64[9]) -> LabTable!:
        var table = LabTable()
        errdefer table.close()
        table.lightness = try new i32[65536] in memory.heap
        table.red_green = try new i32[65536] in memory.heap
        table.blue_yellow = try new i32[65536] in memory.heap
        for i in 0..<table.lightness.length:
            let r = (f64)i / 65535.0
            let f = math.cbrt(r) if r > 0.008856 else 7.787 * r + 16.0 / 116.0
            table.lightness[i] = (i32)(64.0 * (116.0 * f - 16.0))
            table.red_green[i] = (i32)math.round(64.0 * 500.0 * f)
            table.blue_yellow[i] = (i32)math.round(64.0 * 200.0 * f)
        for i: usize in 0..<9:
            table.to_xyz[i] = (i64)math.round(math.clamp(to_xyz[i], -1000.0, 1000.0) * 65536.0)
        return table

    mutating func close():
        if self.lightness.length > 0:
            free(self.lightness) in memory.heap
        if self.red_green.length > 0:
            free(self.red_green) in memory.heap
        if self.blue_yellow.length > 0:
            free(self.blue_yellow) in memory.heap
        self = LabTable()

## An index clamped to 16-bit sample range.
inline func clip16(value: i64) -> usize:
    return 0 if value < 0 else 65535 if value > 65535 else (usize)value

## `value` limited to the range its two neighbours span.
inline func between(value: i64, a: i64, b: i64) -> i64:
    let low = a if a < b else b
    let high = b if a < b else a
    return low if value < low else high if value > high else value

## Scratch for one tile: two directions of RGB, Lab and homogeneity over the
## tile and a three-pixel apron.
struct AhdScratch:
    var rgb: u16[]
    var lab: i32[]
    var homogeneity: u8[]
    var capacity: usize

    static func create(tile: usize) -> AhdScratch!:
        let size = (tile + 6) * (tile + 6)
        var scratch = AhdScratch(capacity = size)
        errdefer scratch.close()
        scratch.rgb = try new u16[size * 6] in memory.heap
        scratch.lab = try new i32[size * 6] in memory.heap
        scratch.homogeneity = try new u8[size * 2] in memory.heap
        return scratch

    mutating func close():
        if self.rgb.length > 0:
            free(self.rgb) in memory.heap
        if self.lab.length > 0:
            free(self.lab) in memory.heap
        if self.homogeneity.length > 0:
            free(self.homogeneity) in memory.heap
        self = AhdScratch()

## AHD for the rectangle [x0, x1) × [y0, y1), which must lie at least five
## pixels inside the plane; results go to `out` as RGB rows of `out_stride`
## pixels starting at (`ox`, `oy`) of `out`'s frame. The work arrays cover the
## rectangle and a three-pixel apron; direction 0 is horizontal, 1 vertical.
func ahd_tile(plane: const Plane*, table: const LabTable*, scratch: AhdScratch*, x0: usize, y0: usize, x1: usize, y1: usize, out: u16[], out_stride: usize, ox: usize, oy: usize):
    let tw = x1 - x0 + 6
    let th = y1 - y0 + 6
    let size = tw * th
    let horizontal = scratch.rgb[..<size * 3]
    let vertical = scratch.rgb[size * 3..<size * 6]
    let lab_h = scratch.lab[..<size * 3]
    let lab_v = scratch.lab[size * 3..<size * 6]
    let homogeneous_h = scratch.homogeneity[..<size]
    let homogeneous_v = scratch.homogeneity[size..<size * 2]
    ahd_green(plane, horizontal, vertical, x0 - 3, y0 - 3, tw, th)
    ahd_red_blue(plane, table, horizontal, lab_h, x0 - 3, y0 - 3, tw, th)
    ahd_red_blue(plane, table, vertical, lab_v, x0 - 3, y0 - 3, tw, th)
    ahd_homogeneity(lab_h, lab_v, homogeneous_h, homogeneous_v, tw, th)
    ahd_combine(horizontal, vertical, homogeneous_h, homogeneous_v, tw, th, out, out_stride, ox, oy)

## Green at every red and blue pixel, interpolated along the row into
## `horizontal` and along the column into `vertical`, limited to the range of
## its two neighbours.
func ahd_green(plane: const Plane*, horizontal: u16[], vertical: u16[], bx: usize, by: usize, tw: usize, th: usize):
    let w = plane.width
    let p = plane.data
    for ty in 0..<th:
        let y = by + ty
        let row = y * w + bx
        let first = (y & 1) * 2
        for tx in 0..<tw:
            if plane.cfa[first + ((bx + tx) & 1)] == 1:
                continue
            let i = row + tx
            let v = (i64)p[i]
            let left = (i64)p[i - 1]
            let right = (i64)p[i + 1]
            let h = ((left + v + right) * 2 - (i64)p[i - 2] - (i64)p[i + 2]) >> 2
            horizontal[(ty * tw + tx) * 3 + 1] = (u16)between(h, left, right)
            let up = (i64)p[i - w]
            let down = (i64)p[i + w]
            let u = ((up + v + down) * 2 - (i64)p[i - 2 * w] - (i64)p[i + 2 * w]) >> 2
            vertical[(ty * tw + tx) * 3 + 1] = (u16)between(u, up, down)

## Red and blue from one direction's green, and the CIELAB of the result.
func ahd_red_blue(plane: const Plane*, table: const LabTable*, rgb: u16[], lab: i32[], bx: usize, by: usize, tw: usize, th: usize):
    let w = plane.width
    let p = plane.data
    let m = table.to_xyz
    for ty in 1..<th - 1:
        let y = by + ty
        let first = (y & 1) * 2
        let below = ((y + 1) & 1) * 2
        for tx in 1..<tw - 1:
            let x = bx + tx
            let at = ty * tw + tx
            let o = at * 3
            let i = y * w + x
            let own = (usize)plane.cfa[first + (x & 1)]
            var value: i64 = 0
            var c = 2 - own
            if own == 1:
                c = (usize)plane.cfa[below + (x & 1)]
                let g = (i64)p[i]
                value = g + (((i64)p[i - 1] + (i64)p[i + 1] - (i64)rgb[o - 2] - (i64)rgb[o + 4]) >> 1)
                rgb[o + 2 - c] = (u16)clip16(value)
                value = g + (((i64)p[i - w] + (i64)p[i + w] - (i64)rgb[o - tw * 3 + 1] - (i64)rgb[o + tw * 3 + 1]) >> 1)
            else:
                let corners = (i64)p[i - w - 1] + (i64)p[i - w + 1] + (i64)p[i + w - 1] + (i64)p[i + w + 1]
                let up = o - tw * 3
                let down = o + tw * 3
                let greens = (i64)rgb[up - 2] + (i64)rgb[up + 4] + (i64)rgb[down - 2] + (i64)rgb[down + 4]
                value = (i64)rgb[o + 1] + ((corners - greens + 1) >> 2)
            rgb[o + c] = (u16)clip16(value)
            rgb[o + own] = p[i]
            let r = (i64)rgb[o]
            let g = (i64)rgb[o + 1]
            let b = (i64)rgb[o + 2]
            let fx = clip16((m[0] * r + m[1] * g + m[2] * b + 32768) >> 16)
            let fy = clip16((m[3] * r + m[4] * g + m[5] * b + 32768) >> 16)
            let fz = clip16((m[6] * r + m[7] * g + m[8] * b + 32768) >> 16)
            lab[o] = table.lightness[fy]
            lab[o + 1] = table.red_green[fx] - table.red_green[fy]
            lab[o + 2] = table.blue_yellow[fy] - table.blue_yellow[fz]

## For each pixel and direction, how many of its four neighbours lie within
## the tighter direction's lightness and chroma tolerance.
func ahd_homogeneity(lab_h: const i32[], lab_v: const i32[], out_h: u8[], out_v: u8[], tw: usize, th: usize):
    let row = tw * 3
    for ty in 2..<th - 2:
        for tx in 2..<tw - 2:
            let o = (ty * tw + tx) * 3
            # Horizontal: left, right, up, down.
            let hl0 = difference_l(lab_h, o, o - 3)
            let hl1 = difference_l(lab_h, o, o + 3)
            let hl2 = difference_l(lab_h, o, o - row)
            let hl3 = difference_l(lab_h, o, o + row)
            let ha0 = difference_ab(lab_h, o, o - 3)
            let ha1 = difference_ab(lab_h, o, o + 3)
            let ha2 = difference_ab(lab_h, o, o - row)
            let ha3 = difference_ab(lab_h, o, o + row)
            let vl0 = difference_l(lab_v, o, o - 3)
            let vl1 = difference_l(lab_v, o, o + 3)
            let vl2 = difference_l(lab_v, o, o - row)
            let vl3 = difference_l(lab_v, o, o + row)
            let va0 = difference_ab(lab_v, o, o - 3)
            let va1 = difference_ab(lab_v, o, o + 3)
            let va2 = difference_ab(lab_v, o, o - row)
            let va3 = difference_ab(lab_v, o, o + row)
            let hl = hl0 if hl0 > hl1 else hl1
            let vl = vl2 if vl2 > vl3 else vl3
            let leps = hl if hl < vl else vl
            let ha = ha0 if ha0 > ha1 else ha1
            let va = va2 if va2 > va3 else va3
            let abeps = ha if ha < va else va
            var h: u8 = 0
            var v: u8 = 0
            if hl0 <= leps and ha0 <= abeps: h += 1
            if hl1 <= leps and ha1 <= abeps: h += 1
            if hl2 <= leps and ha2 <= abeps: h += 1
            if hl3 <= leps and ha3 <= abeps: h += 1
            if vl0 <= leps and va0 <= abeps: v += 1
            if vl1 <= leps and va1 <= abeps: v += 1
            if vl2 <= leps and va2 <= abeps: v += 1
            if vl3 <= leps and va3 <= abeps: v += 1
            out_h[ty * tw + tx] = h
            out_v[ty * tw + tx] = v

inline func difference_l(lab: const i32[], a: usize, b: usize) -> i64:
    let d = (i64)lab[a] - (i64)lab[b]
    return d if d >= 0 else -d

inline func difference_ab(lab: const i32[], a: usize, b: usize) -> i64:
    let da = (i64)lab[a + 1] - (i64)lab[b + 1]
    let db = (i64)lab[a + 2] - (i64)lab[b + 2]
    return da * da + db * db

## Each pixel takes the direction more homogeneous over its 3×3 neighbourhood,
## or the mean of both on a tie.
func ahd_combine(horizontal: const u16[], vertical: const u16[], homogeneous_h: const u8[], homogeneous_v: const u8[], tw: usize, th: usize, out: u16[], out_stride: usize, ox: usize, oy: usize):
    for ty in 3..<th - 3:
        let target_row = (oy + ty - 3) * out_stride + ox
        for tx in 3..<tw - 3:
            var h: u32 = 0
            var v: u32 = 0
            for yy in ty - 1..=ty + 1:
                let at = yy * tw + tx
                h += (u32)homogeneous_h[at - 1] + (u32)homogeneous_h[at] + (u32)homogeneous_h[at + 1]
                v += (u32)homogeneous_v[at - 1] + (u32)homogeneous_v[at] + (u32)homogeneous_v[at + 1]
            let o = (ty * tw + tx) * 3
            let target = (target_row + tx - 3) * 3
            if h > v:
                out[target] = horizontal[o]
                out[target + 1] = horizontal[o + 1]
                out[target + 2] = horizontal[o + 2]
            elif v > h:
                out[target] = vertical[o]
                out[target + 1] = vertical[o + 1]
                out[target + 2] = vertical[o + 2]
            else:
                out[target] = (u16)(((u32)horizontal[o] + (u32)vertical[o]) >> 1)
                out[target + 1] = (u16)(((u32)horizontal[o + 1] + (u32)vertical[o + 1]) >> 1)
                out[target + 2] = (u16)(((u32)horizontal[o + 2] + (u32)vertical[o + 2]) >> 1)
