#==============================================================================================
#
#   raw/levels - Black and white levels, white balance and clipping
#
#   DESCRIPTION:
#       normalize takes the developed region of the mosaic (the active area, or its
#       default crop) and maps every sample to 16 bits where the white level after
#       white balance is 65535: subtract the black level (a repeating pattern plus
#       DNG's per-row and per-column deltas), scale by the white level and the
#       color's multiplier, clip. The demosaic works on that Plane, as dcraw's does.
#
#==============================================================================================

## Balanced, clipped sensor values: `width` × `height` pixels of `channels`
## (one for a color filter mosaic, three for LinearRaw). `pattern` is the 6×6
## filter from the plane's corner; a Bayer filter's 2×2 is also `cfa`.
struct Plane:
    var data: u16[]
    var width: usize
    var height: usize
    var channels: usize
    var cfa: u8[4]
    var pattern: u8[36]
    var xtrans: bool

    ## The filter color at (`x`, `y`).
    func color(x: usize, y: usize) -> usize:
        return (usize)self.pattern[(y % 6) * 6 + x % 6]

    mutating func close():
        if self.data.length > 0:
            free(self.data) in memory.heap
        self = Plane()

## A DNG black delta tag as reals, or empty.
func delta_values(entry: const Entry*, count: usize) -> f64[]!:
    var empty: f64[]
    if entry.count == 0:
        return empty
    if entry.count < count:
        error(corrupt, "DNG black level deltas are too short")
    let out = try new f64[count] in memory.heap
    errdefer free(out) in memory.heap
    for i in 0..<count:
        out[i] = try entry.real(i)
    return out

## Free what `deltas` allocated.
func release(values: f64[]):
    if values.length > 0:
        free(values) in memory.heap

## What each band of `normalize` reads.
struct Levels:
    var meta: const Meta*
    var mosaic: const Mosaic*
    var plane: Plane*
    var horizontal: const f64[]
    var vertical: const f64[]
    var scales: f64[3]
    var ox: usize
    var oy: usize

let band_rows: usize = 64

## Normalize rows [64 × index, 64 × index + 64) of the plane; `parallel` calls it.
func normalize_band(context: void*, index: usize) -> !:
    let job = (Levels*)context
    let meta = job.meta
    let plane = job.plane
    let nc = plane.channels
    let width = plane.width
    let rows = meta.black_rows
    let columns = meta.black_columns
    let end = math.imin((i64)((index + 1) * band_rows), (i64)plane.height)
    for y in index * band_rows..<(usize)end:
        let ay = job.oy + y
        let source = ((meta.top + ay) * job.mosaic.width + meta.left + job.ox) * nc
        let target = y * width * nc
        let row_black = (ay % rows) * columns
        let row_delta = job.vertical[ay] if job.vertical.length > 0 else 0.0
        for x in 0..<width:
            let ax = job.ox + x
            let pattern = (row_black + ax % columns) * nc
            let column_delta = job.horizontal[ax] if job.horizontal.length > 0 else 0.0
            for s in 0..<nc:
                let color = s if nc == 3 else (usize)meta.pattern[(ay % 6) * 6 + ax % 6]
                let black = meta.black[pattern + s] + row_delta + column_delta
                let value = ((f64)job.mosaic.data[source + x * nc + s] - black) * job.scales[color]
                plane.data[target + x * nc + s] = 65535 if value >= 65535.0 else u16(value) if value > 0.0 else 0

## The balanced Plane of `mosaic`'s active area, or of its default crop.
func normalize(meta: const Meta*, mosaic: const Mosaic*, look: const Development*, crop: bool, threads: usize) -> Plane!:
    let ox = meta.crop_x if crop else 0
    let oy = meta.crop_y if crop else 0
    let width = meta.crop_width if crop else meta.width
    let height = meta.crop_height if crop else meta.height
    let nc = meta.samples
    let count = width *? height else error(limit, "raw image size overflows")
    var plane = Plane(width = width, height = height, channels = nc)
    plane.data = try new u16[count *? nc else error(limit, "raw image size overflows")] in memory.heap
    errdefer plane.close()
    plane.xtrans = meta.xtrans
    for i: usize in 0..<36:
        plane.pattern[i] = (u8)meta.color(ox + i % 6, oy + i // 6)
    for i: usize in 0..<4:
        plane.cfa[i] = plane.pattern[(i // 2) * 6 + i % 2]
    let horizontal = try delta_values(&meta.black_h, meta.width)
    defer release(horizontal)
    let vertical = try delta_values(&meta.black_v, meta.height)
    defer release(vertical)
    # The scale of each color: multiplier × 65535 / (white − black); black varies
    # per position, so the white's span is taken against the pattern's first entry.
    var job = Levels(meta = meta, mosaic = mosaic, plane = &plane, horizontal = horizontal, vertical = vertical, ox = ox, oy = oy)
    for c: usize in 0..<3:
        let white = meta.white[c if nc == 3 else 0]
        let span = white - meta.black[c if nc == 3 else 0]
        if span <= 0.0:
            error(corrupt, "raw white level is not above the black level")
        job.scales[c] = look.multipliers[c] * 65535.0 / span
    try parallel((height + band_rows - 1) // band_rows, threads, (void*)&job, normalize_band)
    return plane
